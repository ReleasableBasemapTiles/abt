{
    "layer_id": "water_polygon",
    "description": "",
    "geometry_type": "polygon",
    "attributes": [
        {"name": "subclass", "type": "string",  "description": ""},
        {"name": "z_level",  "type": "int",     "description": ""},
        {"name": "capped",   "type": "bool",    "description": "true only for touching-cluster member features below z12 (see carto_sql/005a_water_polygon.sql); stops them from rendering at z12+, where the merged z_level=12 replacement takes over instead. Filter-only, not styled."}
    ],
    "source_attribution": "",
    "tippecanoe_options": {
        "minimum_zoom": 0,
        "maximum_zoom": 13,
        "additional_flags": "--simplify-only-low-zooms --no-tiny-polygon-reduction-at-maximum-zoom --hilbert --coalesce --detect-longitude-wraparound",
        "filter": {
            "*": [
                "any",
                ["all", [">=", "$zoom", 0], ["<=", "$zoom", 4], ["==", "z_level", 1]],

                ["all", [">=", "$zoom", 5], ["==", "z_level", 5], ["==", "capped", false]],
                ["all", [">=", "$zoom", 5], ["<", "$zoom", 12], ["==", "z_level", 5], ["==", "capped", true]],

                ["all", [">=", "$zoom", 6], ["==", "z_level", 6], ["==", "capped", false]],
                ["all", [">=", "$zoom", 6], ["<", "$zoom", 12], ["==", "z_level", 6], ["==", "capped", true]],

                ["all", [">=", "$zoom", 7], ["==", "z_level", 7], ["==", "capped", false]],
                ["all", [">=", "$zoom", 7], ["<", "$zoom", 12], ["==", "z_level", 7], ["==", "capped", true]],

                ["all", [">=", "$zoom", 8], ["==", "z_level", 8], ["==", "capped", false]],
                ["all", [">=", "$zoom", 8], ["<", "$zoom", 12], ["==", "z_level", 8], ["==", "capped", true]],

                ["all", [">=", "$zoom", 9], ["==", "z_level", 9], ["==", "capped", false]],
                ["all", [">=", "$zoom", 9], ["<", "$zoom", 12], ["==", "z_level", 9], ["==", "capped", true]],

                ["all", [">=", "$zoom", 10], ["==", "z_level", 10], ["==", "capped", false]],
                ["all", [">=", "$zoom", 10], ["<", "$zoom", 12], ["==", "z_level", 10], ["==", "capped", true]],

                ["all", [">=", "$zoom", 11], ["==", "z_level", 11], ["==", "capped", false]],
                ["all", [">=", "$zoom", 11], ["<", "$zoom", 12], ["==", "z_level", 11], ["==", "capped", true]],

                ["all", [">=", "$zoom", 12], ["==", "z_level", 12], ["==", "capped", false]]
            ]
        }
    },
    "ogr_export_options": {
        "additional_flags": "-lco SPATIAL_INDEX=NO -nlt PROMOTE_TO_MULTI"
    }
}
