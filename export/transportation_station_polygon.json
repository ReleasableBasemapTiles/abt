{
    "layer_id": "transportation_station_polygon",
    "description": "",
    "geometry_type": "polygon",
    "attributes": [
        {"name": "subclass",  "type": "string", "description": ""},
        {"name": "name",      "type": "string", "description": ""},
        {"name": "operator",  "type": "string", "description": ""},
        {"name": "station",   "type": "string", "description": ""},
        {"name": "service",   "type": "string", "description": ""},
        {"name": "platforms", "type": "string", "description": ""},
        {"name": "area",      "type": "float",  "description": ""}
    ],
    "source_attribution": "",
    "tippecanoe_options": {
        "minimum_zoom": 11,
        "maximum_zoom": 13,
        "additional_flags": "--drop-rate=1 --hilbert",
        "filter": {
            "*": [
                "any",
                ["all", [">=", "$zoom", 11], ["<=", "$zoom", 12],
                 ["in", "subclass", "bus_station", "ferry_terminal", "rest_area", "services", "station"],
                 [">=", "area", 625]
                ],
                ["all", ["==", "$zoom", 13],
                 ["in", "subclass", "bus_station", "ferry_terminal", "rest_area", "services", "station", "platform"]
                ]
            ]
        }
    },
    "ogr_export_options": {
        "additional_flags": "-lco SPATIAL_INDEX=NO -nlt PROMOTE_TO_MULTI"
    }
}
