        {"name": "intermittent", "type": "string", "description": ""},
        {"name": "z_level",      "type": "int",    "description": ""},
        {"name": "area",         "type": "int",    "description": ""}
    ],
    "source_attribution": "",
    "tippecanoe_options": {
        "minimum_zoom": 4,
        "maximum_zoom": 13,
        "additional_flags": "--simplify-only-low-zooms --no-tiny-polygon-reduction-at-maximum-zoom --hilbert --coalesce --detect-longitude-wraparound --no-feature-limit --no-tile-size-limit",
