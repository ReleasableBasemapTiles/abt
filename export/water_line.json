{
    "layer_id": "water_line",
    "description": "",
    "geometry_type": "linestring",
    "attributes": [
        {"name": "brunnel",      "type": "string",  "description": "bridge or tunnel"},
        {"name": "culvert",      "type": "bool",    "description": "true if tunnel=culvert"},
        {"name": "intermittent", "type": "string", "description": ""},
        {"name": "name",         "type": "string", "description": ""},
        {"name": "subclass",     "type": "string", "description": ""},
        {"name": "z_level",      "type": "int",    "description": ""}
    ],
    "source_attribution": "",
    "tippecanoe_options": {
        "minimum_zoom": 6,
        "maximum_zoom": 13,
        "additional_flags": "--simplify-only-low-zooms",
        "filter": {
            "*": [
                "any",
                ["all", [">=", "$zoom", 6],  ["<=", "$zoom", 9],  ["==", "z_level", 6]],
                ["all", [">=", "$zoom", 7],  ["<=", "$zoom", 9],  ["==", "z_level", 7]],
                ["all", [">=", "$zoom", 8],  ["<=", "$zoom", 9],  ["==", "z_level", 8]],
                ["all", [">=", "$zoom", 9],  ["<=", "$zoom", 9],  ["==", "z_level", 9]],
                ["all", [">=", "$zoom", 10], ["==", "z_level", 10]],
                ["all", [">=", "$zoom", 11], ["==", "z_level", 11]],
                ["all", [">=", "$zoom", 12], ["==", "z_level", 12]],
                ["all", [">=", "$zoom", 13], ["==", "z_level", 13]]
            ]
        }
    },
    "ogr_export_options": {
        "additional_flags": "-lco SPATIAL_INDEX=NO"
    }
}
